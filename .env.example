# Local development configuration.
#
# Real environment variables take priority over this file, so a platform's
# injected settings (e.g. Railway) are never shadowed by a checked-in .env.
#
# On Railway, do not set these: reference the database service instead, with
#   MYSQL_URL=${{MySQL.MYSQL_URL}}
# and the app switches to MySQL automatically.

# mysql, or sqlite to use the local database/franco_pay.sqlite file
DB_DRIVER=sqlite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=franco_pay
DB_USER=root
DB_PASS=

# Secret used to hash/encrypt sensitive audit values. Set a unique value in
# any real deployment.
# APP_KEY=change-me
