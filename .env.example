# Copy this file to `.env` and set the values for your host before uploading.
# Supported drivers: `mysql` or `sqlite` (sqlite uses `database/franco_pay.sqlite`).

# Database driver to use: mysql or sqlite
DB_DRIVER=mysql

# MySQL settings (set when DB_DRIVER=mysql)
DB_HOST=your_mysql_host
DB_PORT=3306
DB_NAME=franco_pay
DB_USER=your_db_user
DB_PASS=your_db_password

# If you prefer SQLite, set:
# DB_DRIVER=sqlite
# (the app will use database/franco_pay.sqlite)

# Optional secret used for hashing/encryption. Set a strong random value in
# production deployments.
APP_KEY=
